///|
test "registry public include exclude wildcard distinction and explanation" {
  let paths = [
    "main.mbt", "src/a.mbt", "src/sub/b.mbt", "vendor/a.mbt", "README.md",
  ]
  let plan = @moonpathspec.compile(["*.mbt", ":(exclude)vendor"]).unwrap()
  assert_eq(@moonpathspec.select(plan, paths).unwrap().selected, [
    "main.mbt", "src/a.mbt", "src/sub/b.mbt",
  ])
  let glob = @moonpathspec.compile([":(glob)src/*.mbt"]).unwrap()
  assert_eq(@moonpathspec.select(glob, paths).unwrap().selected, ["src/a.mbt"])
  let reason = @moonpathspec.explain(plan, "vendor/a.mbt").unwrap()
  assert_eq(reason.selected, false)
  assert_eq(reason.included_by, [0])
  assert_eq(reason.excluded_by, [1])
  assert_eq(reason.reason, "excluded_by_pattern")
}

///|
test "registry public prefix literal top and plan input independence" {
  let patterns = [":(literal)a[1].mbt"]
  let plan = @moonpathspec.compile(patterns, prefix="src/./sub/..").unwrap()
  patterns[0] = "missing"
  let paths = ["a[1].mbt", "src/a[1].mbt", "src/a1.mbt", "src/sub/a[1].mbt"]
  assert_eq(@moonpathspec.select(plan, paths).unwrap().selected, [
    "src/a[1].mbt",
  ])
  let top = @moonpathspec.compile([":(top,literal)a[1].mbt"], prefix="src").unwrap()
  assert_eq(@moonpathspec.select(top, paths).unwrap().selected, ["a[1].mbt"])
  let parsed = @moonpathspec.parse_pattern(":(top,literal)a[1].mbt").unwrap()
  assert_eq(parsed.magic.top, true)
  assert_eq(parsed.magic.literal, true)
  assert_eq(parsed.pattern, "a[1].mbt")
}

///|
test "registry public attributes retain all four states and empty strings" {
  let paths = ["set", "unset", "value", "empty", "missing"]
  let attribute = fn(path, name) {
    if name != "state" {
      return @moonpathspec.AttributeValue::Unspecified
    }
    match path {
      "set" => @moonpathspec.AttributeValue::Set
      "unset" => @moonpathspec.AttributeValue::Unset
      "value" => @moonpathspec.AttributeValue::Value("ready")
      "empty" => @moonpathspec.AttributeValue::Value("")
      _ => @moonpathspec.AttributeValue::Unspecified
    }
  }
  for
    (pattern, expected) in [
      (":(attr:state)*", ["set"]),
      (":(attr:-state)*", ["unset"]),
      (":(attr:state=ready)*", ["value"]),
      (":(attr:state=)*", ["empty"]),
      (":(attr:!state)*", ["missing"]),
    ] {
    let plan = @moonpathspec.compile([pattern]).unwrap()
    assert_eq(
      @moonpathspec.select(plan, paths, attribute~).unwrap().selected,
      expected,
    )
  }
}

///|
fn registry_field(value : Json, name : String) -> Json {
  match value {
    Object(fields) => fields.get(name).unwrap()
    _ => abort("expected JSON object")
  }
}

///|
test "registry public selection snapshots candidates before callbacks" {
  let paths = ["a", "b"]
  let plan = @moonpathspec.compile([":(attr:ready)*"]).unwrap()
  let result = @moonpathspec.select(plan, paths, attribute=fn(path, _) {
    if path == "a" {
      paths[1] = "../outside"
    }
    @moonpathspec.AttributeValue::Set
  }).unwrap()
  assert_eq(result.selected, ["a", "b"])
  assert_eq(result.decisions.map(d => d.path), ["a", "b"])
  assert_eq(paths, ["a", "../outside"])
}

///|
test "registry public errors budgets and JSON bridge fail without partial data" {
  match @moonpathspec.compile(["valid", ":(attr:a=值)x"]) {
    Ok(_) => abort("expected invalid attribute")
    Err(error) => {
      assert_eq(error.code, "invalid_attribute")
      assert_eq(error.pattern_index, Some(1))
      assert_eq(error.offset, Some(9))
    }
  }
  let limited = @moonpathspec.compile(["*"], limits={
    ..@moonpathspec.default_limits(),
    max_match_steps: 1,
  }).unwrap()
  match @moonpathspec.select(limited, ["long-path"]) {
    Ok(_) => abort("expected budget error")
    Err(error) => {
      assert_eq(error.code, "match_budget_exceeded")
      assert_eq(error.path_index, Some(0))
    }
  }
  let response = @moonpathspec.dispatch(
    "{\"patterns\":[\"src\",\":!src/tmp\"],\"paths\":[\"src/a\",\"src/tmp/b\",\"root\"]}",
  )
  let json = @json.parse(response[:])
  assert_eq(registry_field(json, "schema_version"), Json(1))
  assert_eq(registry_field(json, "exit_code"), Json(0))
  assert_eq(registry_field(json, "selected"), Json(["src/a"]))
  let failure = @moonpathspec.dispatch(
    "{\"patterns\":[\"*\"],\"paths\":[\"a\"],\"limits\":{\"max_match_steps\":1}}",
  )
  let json = @json.parse(failure[:])
  assert_eq(registry_field(json, "exit_code"), Json(2))
  assert_eq(registry_field(json, "selected"), Json::array([]))
  assert_eq(
    registry_field(registry_field(json, "error"), "code"),
    Json("match_budget_exceeded"),
  )
}

///|
test "registry public escaped wildcards combine literal fallback and exclusion" {
  let paths = [
    "docs/a[draft].txt", "docs/b[draft].txt", "docs/nested/a[draft].txt",
    "docs/ad.txt", "docs/a*report.txt", "docs/abreport.txt",
  ]
  let plan = @moonpathspec.compile([
    ":(top,glob)docs/*\\[draft\\].txt", ":(top)docs/a\\*report.txt",
    ":(top,exclude)docs/b\\[draft\\].txt",
  ]).unwrap()
  assert_eq(@moonpathspec.select(plan, paths).unwrap().selected, [
    "docs/a[draft].txt", "docs/a*report.txt",
  ])
  let reason = @moonpathspec.explain(plan, "docs/b[draft].txt").unwrap()
  assert_eq(reason.included_by, [0])
  assert_eq(reason.excluded_by, [2])
  let malformed = @moonpathspec.compile(["a[broken"]).unwrap()
  assert_eq(
    @moonpathspec.select(malformed, ["a[broken", "abroken"]).unwrap().selected,
    ["a[broken"],
  )
}

///|
test "registry public global settings and protected prefix are available" {
  let options = { ..@moonpathspec.default_pathspec_options(), glob: true, }
  let plan = @moonpathspec.compile(["*.txt"], options~).unwrap()
  assert_eq(
    @moonpathspec.select(plan, ["a.txt", "sub/b.txt"]).unwrap().selected,
    ["a.txt"],
  )
  let plan = @moonpathspec.compile([":(prefix:4,icase)src/A*"]).unwrap()
  assert_eq(
    @moonpathspec.select(plan, ["src/abc", "SRC/abc"]).unwrap().selected,
    ["src/abc"],
  )
  let posix = @moonpathspec.compile(["a\\*"]).unwrap()
  let windows = @moonpathspec.compile(["a\\*"], options={
    ..@moonpathspec.default_pathspec_options(), windows: true,
  }).unwrap()
  let paths = ["a*", "a/file", "abc"]
  assert_eq(@moonpathspec.select(posix, paths).unwrap().selected, ["a*"])
  assert_eq(@moonpathspec.select(windows, paths).unwrap().selected, ["a/file"])
}

///|
test "registry JSON environment retains Linux and Windows numeric distinction" {
  let request : Json = {
    "patterns": Json([":(top)A.TXT"]),
    "paths": Json(["a.txt"]),
    "environment": { "GIT_ICASE_PATHSPECS": Json("0b1") },
  }
  let output = @moonpathspec.dispatch(request.stringify())
  let result = @json.parse(output[:])
  assert_eq(registry_field(result, "selected"), Json(["a.txt"]))
  let request : Json = {
    "patterns": Json([":(top)A.TXT"]),
    "paths": Json(["a.txt"]),
    "options": { "windows": Json(true) },
    "environment": { "GIT_ICASE_PATHSPECS": Json("0b1") },
  }
  let output = @moonpathspec.dispatch(request.stringify())
  let result = @json.parse(output[:])
  assert_eq(registry_field(result, "exit_code"), Json(2))
  assert_eq(registry_field(result, "selected"), Json::array([]))
}

///|
test "registry public reference version preserves Git 2.43 integer errors" {
  let reference = { ..@moonpathspec.default_pathspec_options(), git_version: "2.43.0", }
  let plan = @moonpathspec.compile(["a*"], options=reference).unwrap()
  assert_eq(@moonpathspec.select(plan, ["abc"]).unwrap().selected, ["abc"])
  let request : Json = {
    "patterns": Json(["A"]), "paths": Json(["a"]),
    "options": { "git_version": Json("2.43.0") },
    "environment": { "GIT_ICASE_PATHSPECS": Json("-2g") },
  }
  let output = @moonpathspec.dispatch(request.stringify())
  assert_eq(registry_field(@json.parse(output[:]), "exit_code"), Json(2))
}
