{
  "schema_version": 1,
  "profile": {
    "name": "GPP-1 UTF-8 Git pathspec selection profile",
    "oracle": "git ls-files --full-name -z -- <patterns>; staged UTF-8 paths; no commits",
    "cwd": "prefix names an existing repository directory",
    "order": "Expected Git set is restored to caller candidate order",
    "attributes": "Working-tree .gitattributes, read with git check-attr -z for every candidate/name pair; all four states retained",
    "exclusions": "Not a full Git command compatibility claim. No arbitrary non-UTF-8 names, environment pathspec flags, filesystem traversal, tree-ish attributes, platform-specific case folding, symlinks, submodules or sparse index.",
    "explicit_rejections": {
      "unsupported_backslash": "Nonliteral pattern bodies containing a backslash are explicitly rejected. Git results are retained as research observations; these checks are counted separately from differential equivalence. Use literal magic for literal metacharacters."
    }
  },
  "attribute_names": [
    "flag",
    "review",
    "kind",
    "tag",
    "missing"
  ],
  "gitattributes": "*.txt flag -review kind=text\ndocs/** review kind=doc\nsrc/** kind=source tag=stable\nsrc/lib/util.mbt -flag review kind=library\nassets/** -flag -review\nvendor/** !flag !review !kind !tag\nunicode/** -review tag=utf8\n\"space dir/a file.txt\" flag review tag=space\n",
  "paths": [
    "README.md",
    "root.txt",
    ".hidden",
    "foo",
    "x",
    "src/main.mbt",
    "src/App.MBT",
    "src/lib/util.mbt",
    "src/lib/helper.txt",
    "src/lib/deep/code.mbt",
    "src/foo",
    "docs/guide.md",
    "docs/a.txt",
    "docs/ab.txt",
    "docs/[draft].txt",
    "docs/nested/page.md",
    "docs/nested/foo",
    "docs/UPPER.TXT",
    "assets/image.png",
    "assets/icons/tiny.svg",
    "vendor/keep.txt",
    "vendor/lib/code.mbt",
    "space dir/a file.txt",
    "space dir/nested/file.md",
    "unicode/猫.txt",
    "unicode/😀.txt",
    "unicode/é.txt",
    "unicode/é.txt",
    "unicode/x.txt",
    "unicode/λ.mbt",
    "a/x",
    "a/b",
    "a/xb",
    "a/z/xb",
    "a/z/b",
    "a/z/deep/b",
    "a/aab",
